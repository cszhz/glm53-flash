From 4283e235e5528dec0b968e8ae55950883ba57fc7 Mon Sep 17 00:00:00 2001
From: zzl <zzl@google.com>
Date: Thu, 22 Oct 2026 13:22:19 +0000
Subject: [PATCH 2/2] [Core] SharedPrefillBudgetScheduler: water-fill prefill
 caps under Mamba align

With prefix caching on a hybrid model, prefill chunks must end on block
boundaries and GLM-5.3's unified pool makes a block 2048 tokens, so an even
block-aligned share wastes budget whenever it is not a whole number of
blocks (six prompts: 1024 each, 6144 of 8192). Under align mode, cap each
prompt in _mamba_block_aligned_split at the remaining budget over the
prompts still to be scheduled, so what alignment trims off one prompt goes
to the next.

200K on two hosts (DP2 x TP8, prefix caching on, cold prompts):
c8 TTFT 32.8 -> 29.3 s, 5366 -> 6564 tok/s/chip; c12 TTFT 63.6 -> 45.6 s,
TPOT p90 81 -> 31 ms, 4597 -> 6382 tok/s/chip (per-layer baseline: 28.3 s /
6821 and 44.7 s / 6502). Without align mode the behaviour is unchanged.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../core/decode_aware_chunk_scheduler.py      | 63 ++++++++++++++++++-
 1 file changed, 61 insertions(+), 2 deletions(-)

diff --git a/src/vllm_torchtpu/core/decode_aware_chunk_scheduler.py b/src/vllm_torchtpu/core/decode_aware_chunk_scheduler.py
index 2e4f70e2f..5ba4ccd1b 100644
--- a/src/vllm_torchtpu/core/decode_aware_chunk_scheduler.py
+++ b/src/vllm_torchtpu/core/decode_aware_chunk_scheduler.py
@@ -27,6 +27,15 @@ together, so their decodes then run without prefill chunks in between.
 Measured at 200K on one TPU7x host: a fixed 2048 cap took c4 TPOT from 111 ms
 to 7 ms but cost 32% TTFT at c1, which this avoids.
 
+With Mamba ``align`` caching (prefix caching on a hybrid model) prefill
+chunks must end on block boundaries, and GLM-5.3's unified pool makes a block
+2048 tokens. An even, block-aligned share then wastes budget whenever the
+share is not a whole number of blocks: six prompts got 1024 each, 6144 of
+8192 (c12 on two hosts: TTFT 44.7 -> 63.6 s). There the share is instead
+water-filled per request in `_mamba_block_aligned_split`: each prompt may
+take the remaining budget over the prompts still to be scheduled this step,
+and what alignment trims off one prompt is left for the next.
+
 Select it with
 ``--scheduler-cls vllm_torchtpu.core.decode_aware_chunk_scheduler.SharedPrefillBudgetScheduler``.
 """
@@ -47,6 +56,8 @@ class SharedPrefillBudgetScheduler(AsyncScheduler):
         self._configured_threshold = self.scheduler_config.long_prefill_token_threshold
         self._floor = int(os.environ.get("TPU_PREFILL_CHUNK_FLOOR", "1024"))
         self._align = self.cache_config.block_size
+        # [prefill budget left, prefilling prompts left] while water-filling.
+        self._fill: list[int] | None = None
         logger.info(
             "SharedPrefillBudgetScheduler: step budget %d split over prefilling "
             "prompts (floor %d, aligned to %d).",
@@ -66,9 +77,57 @@ class SharedPrefillBudgetScheduler(AsyncScheduler):
             self.max_num_running_reqs - decoding,
         )
         threshold = self._configured_threshold
-        if prefilling > 1:
+        self._fill = None
+        if prefilling > 1 and self.need_mamba_block_aligned_split:
+            # Per-request caps in `_mamba_block_aligned_split` instead of one
+            # uniform cap here.
+            self._fill = [self.max_num_scheduled_tokens - decoding, prefilling]
+            threshold = 0
+        elif prefilling > 1:
             share = self.max_num_scheduled_tokens // prefilling
             share = max(self._floor, share // self._align * self._align)
             threshold = min(threshold, share) if threshold > 0 else share
         self.scheduler_config.long_prefill_token_threshold = threshold
-        return super().schedule(*args, **kwargs)
+        try:
+            return super().schedule(*args, **kwargs)
+        finally:
+            self._fill = None
+
+    def _mamba_block_aligned_split(
+        self,
+        request,
+        num_new_tokens: int,
+        num_new_local_computed_tokens: int = 0,
+        num_external_computed_tokens: int = 0,
+    ) -> int:
+        fill = self._fill
+        start = (
+            request.num_computed_tokens
+            + num_new_local_computed_tokens
+            + num_external_computed_tokens
+        )
+        prefill_end = max(request.num_prompt_tokens, request.num_tokens - 1)
+        if fill is None or start >= prefill_end or fill[1] <= 0:
+            return super()._mamba_block_aligned_split(
+                request,
+                num_new_tokens,
+                num_new_local_computed_tokens,
+                num_external_computed_tokens,
+            )
+        cap = max(1, fill[0] // fill[1])
+        # The upstream split reads the threshold too: below one block it lets
+        # a chunk stop short of the boundary instead of rounding it to zero.
+        config = self.scheduler_config
+        config.long_prefill_token_threshold = cap
+        try:
+            n = super()._mamba_block_aligned_split(
+                request,
+                min(num_new_tokens, cap),
+                num_new_local_computed_tokens,
+                num_external_computed_tokens,
+            )
+        finally:
+            config.long_prefill_token_threshold = 0
+        fill[0] -= n
+        fill[1] -= 1
+        return n
-- 
