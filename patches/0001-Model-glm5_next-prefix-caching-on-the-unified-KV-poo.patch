+# leaves the earlier registrations to be garbage-collected, which can take
+# the op's schema with them ("Tried to access the schema for  which doesn't
+# have a schema registered yet" under torch.compile).
 @functools.lru_cache(maxsize=None)
 def _build_kpool_index_v3_sp_op(kpool: int, select_k: int, width: int):
     """The v3 indexer for a sequence-parallel step (see `sp.py`).
@@ -802,6 +860,8 @@ def _build_kpool_index_v3_sp_op(kpool: int, select_k: int, width: int):
                                    q_is_local=True)
         return member_state, key_cache, topk
 
+    _local = _with_pooled_member(_local, kpool)
+
     def _bound(member_state: jax.Array, key_cache: jax.Array,
                k_new: jax.Array, gate_new: jax.Array, q: jax.Array,
                weights: jax.Array, ape: jax.Array, seq_lens: jax.Array,
@@ -867,12 +927,14 @@ def _build_kpool_index_v3_op(kpool: int, select_k: int, width: int,
         mesh = get_pallas_mesh(axis_names=(_TOKEN_SHARD_AXIS, ))
